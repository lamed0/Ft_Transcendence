// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["multischema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["game"]
}

// Add your models here
enum GameMode {
  ONEVONE_QUEUE
  ONEVONE_INVITE

  @@schema("game")

}

enum GameStatus {
  WAITING
  LIVE
  FINISHED
  CANCELED

  @@schema("game")

}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED

  @@schema("game")

}

enum ParticipantRole {
  PLAYER
  SPECTATOR

  @@schema("game")

}

model GameSession {
  id         String     @id @default(uuid())
  mode       GameMode
  status     GameStatus @default(WAITING)

  hostUserId Int?
  offlineP1 String?
  offlineP2 String?
  
  // Player levels at time of game
  playerALevel Int?
  playerBLevel Int?

  createdAt  DateTime @default(now())
  startedAt  DateTime?
  endedAt    DateTime?

  scoreA     Int @default(0)
  scoreB     Int @default(0)

  participants GameParticipant[]

  @@index([status])
  @@index([mode])
  @@index([hostUserId])
  @@schema("game")
}

model GameParticipant {
  id        String @id @default(uuid())
  sessionId String
  userId    Int
  role      ParticipantRole @default(PLAYER)

  joinedAt  DateTime @default(now())
  
  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@schema("game")
}

model GameInvite {
  id         String       @id @default(uuid())
  fromUserId Int
  toUserId   Int
  status     InviteStatus @default(PENDING)

  createdAt  DateTime @default(now())
  respondedAt DateTime?
  sessionId  String?

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
  @@schema("game")
}

model MatchmakingTicket {
  id        String   @id @default(uuid())
  userId    Int      @unique
  status    String   @default("SEARCHING") // SEARCHING | MATCHED | CANCELED

  createdAt DateTime @default(now())
  sessionId String?
  matchedAt DateTime?

  @@index([status])
  @@index([createdAt])
  @@schema("game")
}
