// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum userStatus {
  ONLINE
  OFFLINE
  IN_GAME
}

model users {
  id              Int        @id @default(autoincrement())
  email           String?    @unique
  username        String     @unique
  password        String? // nullable for Google-only users
  googleId        String?    @unique
  avatarUrl       String?
  refreshToken    String?
  ftId            Int?       @unique
  status          userStatus @default(OFFLINE)
  isGuest         Boolean    @default(false)
  isEmailVerified Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailTokens email_token[]

  friendshipsLow   friends[] @relation("FriendshipLow")
  friendshipsHigh  friends[] @relation("FriendshipHigh")

  hostedSessions   GameSession[]
  gameParticipants GameParticipant[]
  sentInvites      GameInvite[]      @relation("InviteFrom")
  receivedInvites  GameInvite[]      @relation("InviteTo")
  matchmakingTicket MatchmakingTicket[]

}

model email_token {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum Friendships_status {
  PENDING
  ACCEPTED
}

model friends{
  id  Int   @id @default(autoincrement())
  userLowId Int
  userHighId  Int
  requestedBy Int
  status  Friendships_status @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userLow     users @relation("FriendshipLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh    users @relation("FriendshipHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([userLowId])
  @@index([userHighId])
  @@index([status])
  @@index([requestedBy])
}

enum GameMode {
  ONEVONE_QUEUE
  ONEVONE_INVITE
}

enum GameStatus {
  WAITING
  LIVE
  FINISHED
  CANCELED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ParticipantRole {
  PLAYER
  SPECTATOR
}

model GameSession {
  id         String     @id @default(uuid())
  mode       GameMode
  status     GameStatus @default(WAITING)

  hostUserId Int?
  offlineP1 String?
  offlineP2 String?     

  createdAt  DateTime @default(now())
  startedAt  DateTime?
  endedAt    DateTime?

  scoreA     Int @default(0)
  scoreB     Int @default(0)

  participants GameParticipant[]

  host users? @relation(fields: [hostUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([mode])
  @@index([hostUserId])
}

model GameParticipant {
  id        String @id @default(uuid())
  sessionId String
  userId    Int
  role      ParticipantRole @default(PLAYER)

  joinedAt  DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    users       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

model GameInvite {
  id         String       @id @default(uuid())
  fromUserId Int
  toUserId   Int
  status     InviteStatus @default(PENDING)

  createdAt  DateTime @default(now())
  respondedAt DateTime?
  sessionId  String?

  from users @relation("InviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to   users @relation("InviteTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
}

model MatchmakingTicket {
  id        String   @id @default(uuid())
  userId    Int      @unique
  status    String   @default("SEARCHING") // SEARCHING | MATCHED | CANCELED

  createdAt DateTime @default(now())
  sessionId String?
  matchedAt DateTime?

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}
